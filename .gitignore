# Rust
/target/
Cargo.lock

# Python
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/
.venv/
.coverage
.coverage.*
htmlcov/

# Test data and caches
# The contents, not the directory: git never descends into an ignored
# directory, so a negation under one has no effect.
tests/data/*
# ...except the committed transit fixtures: small, relation-preserving
# subsets that keep the shape-inference tests running everywhere.
!tests/data/helsinki-transit.osm.pbf
!tests/data/helsinki-transit-gap.osm.pbf
!tests/data/helsinki-transit-missing.osm.pbf
cache/

# Sphinx build artifacts (docs/api holds generated autosummary stubs)
docs/_build/
docs/api/

# Local planning and assistant files (not part of the library)
plans/
.claude/
CLAUDE.md

# Editor / OS
.vscode/
.idea/
.DS_Store
